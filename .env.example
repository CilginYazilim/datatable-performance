# =====================================================================
#  ORTAM DEĞİŞKENLERİ – ÖRNEK DOSYA
#  Bu dosyayı ".env" adıyla kopyalayın ve kendi değerlerinizi yazın.
#      Windows : copy .env.example .env
#      Linux   : cp .env.example .env
#
#  ".env" .gitignore içindedir: depoya gönderilmez ve dağıtım (deploy)
#  onu SİLMEZ. Parolanızı system/config.php içine yazmayın — o dosya
#  depoda durur ve her dağıtımda depodaki sürümle değiştirilir.
#
#  Bu dosyayı hiç oluşturmasanız da uygulama çalışır: config.php
#  yerel XAMPP kurulumuna uygun varsayılanlarla gelir.
# =====================================================================

# --- Veritabanı ------------------------------------------------------
DB_HOST=127.0.0.1
DB_NAME=cy_datatable
DB_USER=root
DB_PASS=

# --- Uygulama --------------------------------------------------------
#  Saat dilimi. PHP'nin date.timezone ayarı MySQL'in kullandığı sistem
#  diliminden farklı olabilir; o zaman ekrandaki saat veritabanındakine
#  göre kayar. Sunucunuz başka bir bölgedeyse burayı değiştirin.
APP_TIMEZONE=Europe/Istanbul

#  APP_DEBUG BİLEREK KAPALI (yorumda) GELİYOR.
#
#  Satır yokken uygulama kendi karar verir: yerel adreslerde
#  (localhost, 127.0.0.1, *.test, *.local) açık, gerçek bir alan
#  adında kapalı olur. Bu, bu dosyayı olduğu gibi kopyalayıp canlıya
#  çıkan birini korur — açık bir hata yığını tablo adlarınızı, sorgu
#  metinlerinizi ve dosya yollarınızı ziyaretçiye gösterir.
#
#  Yalnızca kararı ZORLAMAK istiyorsanız aşağıdaki satırı açın.
# APP_DEBUG=false
